{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bar-observatory.dev/schemas/report-1.0.json",
  "title": "BAR Observatory Deterministic Report",
  "type": "object",
  "required": [
    "schema_version",
    "report",
    "branding",
    "scope",
    "summary",
    "tasks",
    "agents",
    "skills",
    "rework",
    "human_ai_recovery",
    "validation",
    "observations",
    "capture",
    "evidence",
    "integrity"
  ],
  "$defs": {
    "absence_state": {
      "type": "string",
      "enum": [
        "observed",
        "not_recorded",
        "not_applicable",
        "capture_failed",
        "pending_derivation",
        "suppressed",
        "disabled",
        "unknown"
      ],
      "description": "ADR-009's eight absence states. A section with status != observed still renders, never as blank/zero."
    },
    "capture_channel_status": {
      "type": "string",
      "enum": ["complete", "partial", "not_recorded", "capture_failed"]
    },
    "fact_id": {
      "type": "string",
      "minLength": 1,
      "description": "Assigned per docs/17_FACT_ID_NAMESPACE_SPEC.md, rule fact-id.assign.v1."
    },
    "evidence_ref": {
      "type": "string",
      "minLength": 1,
      "description": "Must be a key present in the top-level evidence object."
    }
  },
  "properties": {
    "schema_version": {
      "const": "bar-observatory-report-1.0"
    },
    "report": {
      "type": "object",
      "required": [
        "id",
        "title",
        "generated_at",
        "template_version"
      ],
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "generated_at": { "type": "string", "format": "date-time" },
        "template_version": { "type": "string" },
        "example": { "type": "boolean" },
        "interpretation": {
          "type": "object",
          "required": ["enabled", "status"],
          "properties": {
            "enabled": { "type": "boolean" },
            "status": { "type": "string" }
          }
        }
      },
      "additionalProperties": true
    },
    "branding": {
      "type": "object",
      "required": [
        "product_name",
        "product_expansion",
        "creator_name",
        "studio_name",
        "repository_url",
        "affiliation_disclaimer"
      ],
      "properties": {
        "product_name": { "type": "string" },
        "product_expansion": { "type": "string" },
        "short_name": { "type": "string" },
        "tagline": { "type": "string" },
        "creator_name": { "type": "string" },
        "studio_name": { "type": "string" },
        "repository_url": { "type": "string", "format": "uri" },
        "documentation_url": { "type": "string" },
        "linkedin_url": { "type": "string" },
        "personal_website_url": { "type": "string" },
        "report_address": { "type": "string" },
        "affiliation_disclaimer": { "type": "string" }
      }
    },
    "scope": {
      "type": "object",
      "required": ["type", "session_count"],
      "properties": {
        "type": { "type": "string" },
        "repository": { "type": "string" },
        "branch": { "type": "string" },
        "session_count": { "type": "integer", "minimum": 0 },
        "started_at": { "type": "string" },
        "ended_at": { "type": "string" },
        "active_ms": { "type": "integer", "minimum": 0 }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "tasks_total",
        "tasks_completed_supported",
        "agent_runs",
        "rework_events",
        "tests_passed",
        "tests_failed_final",
        "micro_observations_promoted"
      ],
      "properties": {
        "tasks_total": { "type": "integer" },
        "tasks_completed_supported": { "type": "integer" },
        "tasks_open": { "type": "integer" },
        "tasks_superseded": { "type": "integer" },
        "human_prompts": { "type": "integer" },
        "agent_runs": { "type": "integer" },
        "skills_invoked": { "type": "integer" },
        "files_changed": { "type": "integer" },
        "tokens_total": { "type": "integer" },
        "rework_events": { "type": "integer" },
        "tests_passed": { "type": "integer" },
        "tests_failed_final": { "type": "integer" },
        "micro_observations_promoted": { "type": "integer" },
        "silent_signals": { "type": "integer" }
      }
    },
    "story": {
      "type": "object",
      "properties": {
        "headline": { "type": "string" },
        "sentences": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["template_id", "text", "fact_refs"],
            "properties": {
              "template_id": { "type": "string" },
              "text": { "type": "string" },
              "fact_refs": {
                "type": "array",
                "minItems": 1,
                "items": { "$ref": "#/$defs/fact_id" }
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "required": ["status", "items"],
      "properties": {
        "status": { "$ref": "#/$defs/absence_state" },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "task_id",
              "fact_id",
              "title",
              "state",
              "completion_evidence",
              "attempts",
              "loops",
              "rework_events",
              "evidence_refs"
            ],
            "properties": {
              "task_id": { "type": "string" },
              "fact_id": { "$ref": "#/$defs/fact_id" },
              "title": { "type": "string" },
              "state": {
                "type": "string",
                "enum": [
                  "created", "assigned", "in_progress", "blocked", "validating",
                  "completed", "partially_completed", "superseded", "abandoned",
                  "open_at_session_end"
                ]
              },
              "completion_evidence": {
                "type": "string",
                "enum": [
                  "observed_completed", "supported_completed", "claimed_completed",
                  "open", "superseded", "abandoned", "unknown"
                ]
              },
              "attempts": { "type": "integer", "minimum": 0 },
              "loops": { "type": "integer", "minimum": 0 },
              "rework_events": { "type": "integer", "minimum": 0 },
              "attempt_ids": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Foreign keys into tasks.attempts[].attempt_id — this task's own attempt count above must equal attempt_ids.length."
              },
              "loop_ids": {
                "type": "array",
                "items": { "type": "string" },
                "description": "Foreign keys into tasks.loops[].loop_id — this task's own loop count above must equal loop_ids.length."
              },
              "evidence_refs": {
                "type": "array",
                "items": { "$ref": "#/$defs/evidence_ref" }
              }
            }
          }
        },
        "attempts": {
          "type": "array",
          "description": "First-class attempt registry (review item #5). Every tasks.items[].attempt_ids entry resolves here.",
          "items": {
            "type": "object",
            "required": [
              "attempt_id", "task_id", "start_event", "trigger", "result_state"
            ],
            "properties": {
              "attempt_id": { "type": "string" },
              "task_id": { "type": "string" },
              "agent_ids": { "type": "array", "items": { "type": "string" } },
              "skill_ids": { "type": "array", "items": { "type": "string" } },
              "start_event": { "type": "string" },
              "end_event": { "type": ["string", "null"] },
              "trigger": { "type": "string" },
              "validation_result": { "type": ["string", "null"] },
              "result_state": {
                "type": "string",
                "enum": [
                  "in_progress", "passed", "failed", "superseded", "abandoned", "unknown"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": { "$ref": "#/$defs/evidence_ref" }
              }
            }
          }
        },
        "loops": {
          "type": "array",
          "description": "First-class loop registry (review item #5). Every tasks.items[].loop_ids entry resolves here.",
          "items": {
            "type": "object",
            "required": [
              "loop_id", "task_id", "attempt_ids", "loop_trigger", "resolution", "human_involved"
            ],
            "properties": {
              "loop_id": { "type": "string" },
              "task_id": { "type": "string" },
              "attempt_ids": { "type": "array", "items": { "type": "string" } },
              "loop_trigger": { "type": "string" },
              "resolution": { "type": "string" },
              "human_involved": { "type": "boolean" },
              "evidence_refs": {
                "type": "array",
                "items": { "$ref": "#/$defs/evidence_ref" }
              }
            }
          }
        }
      }
    },
    "agents": {
      "type": "object",
      "required": ["status", "runs"],
      "properties": {
        "status": { "$ref": "#/$defs/absence_state" },
        "runs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "agent_run_id", "fact_id", "display_name", "role", "status",
              "rework_events", "skills"
            ],
            "properties": {
              "agent_run_id": { "type": "string" },
              "fact_id": { "$ref": "#/$defs/fact_id" },
              "display_name": { "type": "string" },
              "role": { "type": "string" },
              "status": { "type": "string" },
              "rework_events": { "type": "integer" },
              "skills": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "skills": {
      "type": "object",
      "required": ["status", "items"],
      "properties": {
        "status": { "$ref": "#/$defs/absence_state" },
        "items": {
          "type": "array",
          "description": "Four-state skill model (review item #6): available/loaded/invoked are distinct captured-or-derived facts, not one flat 'used' boolean; evidenced_in_output is an absence_state because whether a skill's guidance surfaced in the output is not directly captured.",
          "items": {
            "type": "object",
            "required": [
              "skill_id", "fact_id", "task_ids", "agent_run_ids", "evidence_refs",
              "invoked_count", "usage_timing",
              "available", "loaded", "invoked", "loaded_invoked_conflated", "evidenced_in_output"
            ],
            "properties": {
              "skill_id": { "type": "string" },
              "fact_id": { "$ref": "#/$defs/fact_id" },
              "task_ids": { "type": "array", "items": { "type": "string" } },
              "agent_run_ids": { "type": "array", "items": { "type": "string" } },
              "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" } },
              "version_hash": { "type": "string" },
              "invoked_count": { "type": "integer" },
              "loaded_count": { "type": "integer" },
              "usage_timing": { "type": "string" },
              "available": {
                "type": "boolean",
                "description": "Derived from a filesystem catalog scan of declared skills, not a captured DB row (no config_snapshot kind exists for skills, unlike mcp_servers/plugins)."
              },
              "catalog_source": {
                "type": "string",
                "description": "e.g. 'filesystem_scan_at_report_time'. Present only once availability capture exists; omission means availability was not independently verified."
              },
              "loaded": {
                "type": "boolean",
                "description": "Today identical to `invoked` — see loaded_invoked_conflated."
              },
              "loaded_invoked_conflated": {
                "type": "boolean",
                "description": "true until the platform emits a real SkillLoaded event distinct from skill_activated; must not be omitted or silently false."
              },
              "invoked": { "type": "boolean", "description": "invoked_count > 0; directly backed by skill_activated rows." },
              "evidenced_in_output": { "$ref": "#/$defs/absence_state" }
            }
          }
        }
      }
    },
    "rework": {
      "type": "object",
      "required": ["status", "events", "hotspots"],
      "properties": {
        "status": { "$ref": "#/$defs/absence_state" },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "rework_id", "fact_id", "type", "task_id", "rule_id", "confidence", "evidence_refs"
            ],
            "properties": {
              "rework_id": { "type": "string" },
              "fact_id": { "$ref": "#/$defs/fact_id" },
              "type": {
                "type": "string",
                "enum": [
                  "validation_redo", "human_correction", "agent_retry", "task_reopened",
                  "plan_rejected", "file_rework", "rollback_or_revert", "superseded_output",
                  "abandoned_branch_or_worktree", "conflicting_handoff",
                  "routing_change_after_failure", "skill_change_after_failure"
                ]
              },
              "task_id": { "type": "string" },
              "rule_id": { "type": "string" },
              "confidence": { "type": "string" },
              "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" } }
            }
          }
        },
        "hotspots": { "type": "array" }
      }
    },
    "human_ai_recovery": {
      "type": "object",
      "required": ["status", "summary", "events"],
      "properties": {
        "status": { "$ref": "#/$defs/absence_state" },
        "summary": {
          "type": "object",
          "required": ["ai_recovered", "human_assisted", "human_required", "mixed", "unknown"],
          "properties": {
            "ai_recovered": { "type": "integer" },
            "human_assisted": { "type": "integer" },
            "human_required": { "type": "integer" },
            "mixed": { "type": "integer" },
            "unknown": { "type": "integer" }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["recovery_id", "fact_id", "classification", "rule_id"],
            "properties": {
              "recovery_id": { "type": "string" },
              "fact_id": { "$ref": "#/$defs/fact_id" },
              "classification": {
                "type": "string",
                "enum": ["ai_recovered", "human_assisted", "human_required", "mixed", "unknown"]
              },
              "rule_id": { "type": "string" }
            }
          }
        }
      }
    },
    "process": {
      "type": "object",
      "properties": {
        "workflow_id": { "type": "string" },
        "phases": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "fact_id", "label", "rule_id"],
            "properties": {
              "id": { "type": "string" },
              "fact_id": { "$ref": "#/$defs/fact_id" },
              "label": { "type": "string" },
              "rule_id": { "type": "string" }
            }
          }
        }
      }
    },
    "validation": {
      "type": "object",
      "required": ["status", "final"],
      "properties": {
        "status": { "$ref": "#/$defs/absence_state" },
        "attempts": { "type": "integer" },
        "final": {
          "type": "object",
          "required": ["fact_id", "label", "passed", "failed", "skipped", "total"],
          "properties": {
            "fact_id": { "const": "validation.final" },
            "label": { "type": "string" },
            "passed": { "type": "integer", "minimum": 0 },
            "failed": { "type": "integer", "minimum": 0 },
            "skipped": { "type": "integer", "minimum": 0 },
            "total": {
              "type": "integer",
              "minimum": 0,
              "description": "Must equal passed + failed + skipped. Fixes D-04: the renderer never divides passed by passed."
            },
            "command_fingerprint": { "type": "string" },
            "evidence_refs": { "type": "array", "items": { "$ref": "#/$defs/evidence_ref" } }
          }
        }
      }
    },
    "observations": {
      "type": "object",
      "required": ["status", "candidate", "promoted", "featured"],
      "properties": {
        "status": { "$ref": "#/$defs/absence_state" },
        "candidate": { "type": "integer" },
        "promoted": { "type": "integer" },
        "duplicate_linked": { "type": "integer" },
        "rejected": { "type": "integer" },
        "featured": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "fact_id", "kind", "title", "state", "rule_id", "promotion_target"],
            "properties": {
              "id": { "type": "string" },
              "fact_id": { "$ref": "#/$defs/fact_id" },
              "kind": { "type": "string", "enum": ["agent_signal", "unreported_evidence_gap"] },
              "title": { "type": "string" },
              "state": { "type": "string" },
              "rule_id": { "type": "string" },
              "promotion_target": { "type": "string" }
            }
          }
        }
      }
    },
    "capture": {
      "type": "object",
      "required": ["channels"],
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "status"],
            "properties": {
              "id": { "type": "string" },
              "status": { "$ref": "#/$defs/capture_channel_status" },
              "recorded": { "type": "integer" },
              "dropped": { "type": "integer" },
              "coverage_percent": { "type": "number" },
              "reason": { "type": "string" }
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "description": "Registry every evidence_ref anywhere in this document must resolve into. Keys are evidence_ref strings.",
      "additionalProperties": {
        "type": "object",
        "required": ["id", "kind", "source"],
        "properties": {
          "id": { "type": "string" },
          "kind": { "type": "string" },
          "source": { "type": "string" },
          "locator": { "type": "string" },
          "hash": { "type": "string" }
        }
      }
    },
    "reserved": {
      "type": "object",
      "description": "Phase 19-21 (memory / bounded-gradient rendering / source-gated observation) contract stubs, declared-and-disabled per human-specs/02-plan-enhancements.md Gate 2 item 3. Not implemented before those phases; renders as status=disabled.",
      "properties": {
        "memory": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "$ref": "#/$defs/absence_state" } }
        },
        "briefing": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "$ref": "#/$defs/absence_state" } }
        },
        "observations_agent": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "$ref": "#/$defs/absence_state" } }
        },
        "observations_subagent": {
          "type": "object",
          "required": ["status"],
          "properties": { "status": { "$ref": "#/$defs/absence_state" } }
        }
      }
    },
    "provider_usage": {
      "type": "object",
      "description": "Added 2026-07-31, per Bradley's direct ruling: cost is never silently omitted and never silently invented. Matches [measurements.provider_usage] in config — was declared in config with zero schema representation before this addition, a real gap an adversarial review caught. Not in the top-level 'required' list: an empty/absent report still validates (a report predating this field, or one where even the fallback below has no model to price, must not fail schema validation) — the DoD proof is 'status is honest', not 'field exists'.",
      "required": ["status", "cost_source"],
      "properties": {
        "status": { "$ref": "#/$defs/absence_state" },
        "cost_source": {
          "type": "string",
          "enum": ["authoritative", "model_price_fallback", "not_recorded"],
          "description": "authoritative = real provider-billed/proxy-captured cost (e.g. bar-proxy body capture, or an OTLP claude_code.cost.usage metric actually present for this run). model_price_fallback = no authoritative source available; cost derived from (input_tokens, output_tokens, cache tokens) x a published per-model API price table, per Bradley's ruling 2026-07-31 — this is an estimate, and total_cost_usd under this source MUST be rendered as visibly estimated (never presented identically to an authoritative figure). not_recorded = neither source available; total_cost_usd is null, not zero."
        },
        "total_cost_usd": { "type": ["number", "null"] },
        "pricing_reference": {
          "type": ["string", "null"],
          "description": "Required (non-null) when cost_source=model_price_fallback: which model + which published price table/date the fallback estimate used, so the estimate is independently checkable, not asserted."
        }
      }
    },
    "integrity": {
      "type": "object",
      "required": ["renderer_version"],
      "properties": {
        "source_db_hash": { "type": "string" },
        "template_hash": { "type": "string" },
        "renderer_version": { "type": "string" },
        "locale": { "type": "string" },
        "timezone": { "type": "string" },
        "config_hash": {
          "type": "string",
          "description": "Which resolved config produced this report. Canonicalize the resolved config as JSON (recursive key-sort) then hash with blake3, per bar-store's config_snapshot's cited precedent - same discipline, so config identity is stable regardless of TOML key order. Optional (not in the required list): an older report without this field still validates; the DoD proof is that the shipped example carries a real one, not that the field is mandatory."
        },
        "config_layers_summary": {
          "type": "string",
          "description": "One honest sentence naming which config layers actually contributed to this run, sourced directly from bar_obs_config::ResolvedConfig::layer_provenance_sentence() - never inferred by the template. A report field, not template-only context, so it stays a checkable fact like everything else in this document."
        }
      }
    }
  },
  "additionalProperties": false
}
