𝔸3.1.bar-observatory-hub@2026-08-14
γ≔bar-observatory.agent-operations
ρ≔⟨cli,mcp,crates,report,query,capture,agent-comms,proof-carrying,schema,toggles⟩
⊢deterministic∧proof-carrying∧lossless∧self-certifying

;; ─── Ω: SYMBOLS (custom, BAR-scoped, ∅collision∩upstream/aisp/CHEATSHEET.md alphabet) ───
⟦Ω:Symbols⟧{
 𝒦≜crate; 𝒟≜datastore(SQLite_file); ℛ≜report(deterministic_artifact); 𝒬≜query(read_op)
 𝒞≜capture-channel; 𝒜≜agent(dispatch); 𝒮≜skill(invocation); 𝒯≜transcript-turn
 𝒲≜window(multi-session_capture_scope); ℐb≜interpret-brief(7-fact_LLM_input)
 ≺≜depends-on(layer_precedes); ⊑≜sub-component-of
}

;; ─── Ω: META ───
⟦Ω:Meta⟧{
 ID≜bar-observatory; EXP≜Base_Agentic_Reporter; 𝔸≔flight-recorder(local,deterministic,claude-code-sessions)
 AUD≜agent∨swarm; READ_ORDER≜this≺∀other_wiki_doc(δ_max,∅prose_prereq,per⟦Γ:Agent⟧)
 DIST≜crates.io; INSTALL≜cargo_install_bar-observatory(binary=bar)
 PLUGIN≜/plugin_marketplace_add_bar181/bar-observatory∘/plugin_install_bar-observatory@bar-observatory
 REPO≜github.com/bar181/bar-observatory(front-door+docs+examples;∅𝒦_source,by_design)
 NAME≜{BossMode↦executive_register,DeveloperGuide↦engineering_register}(CLI_flag≜--audience_executive|engineering,unchanged)
}

;; ─── Σ: CRATE ARCHITECTURE (16𝒦, crates.io-published, function-scoped) ───
⟦Σ:Crates⟧{
 L≜{L0,L0.5,L1,L2,L3}; L0≺L0.5≺L1≺L2≺L3(dependency_direction;∀spoke⊑bar-store,hub-and-spoke)

 𝒦map≜{
  bar-obs-config ↦ ⟨L0, layered_TOML_config_resolve⟩,
  bar-schema     ↦ ⟨L0, ReportDocument_type+fact_id_assign⟩,
  bar-store      ↦ ⟨L0, 𝒟_schema+Substrate_trait(hub,∅internal_deps)⟩,
  bar-registry   ↦ ⟨L0, capability_metadata(∅deps_by_design)⟩,
  bar-index      ↦ ⟨L0.5≺bar-store, cross-run_catalog+artifact_store⟩,
  bar-read       ↦ ⟨L1≺bar-store, 𝒬_surface(named+guarded_raw_SELECT)⟩,
  bar-hook       ↦ ⟨L1≺bar-store, hook_binary(stdin_JSON→𝒟)⟩,
  bar-otlp       ↦ ⟨L1≺bar-store, OTLP_gRPC_receiver⟩,
  bar-proxy      ↦ ⟨L1≺bar-store, ANTHROPIC_BASE_URL_interceptor⟩,
  bar-sanitize   ↦ ⟨≺bar-store,bar-index, PII_scrub(capture→publish-safe_copy)⟩,
  bar-ingest     ↦ ⟨L1≺bar-store,bar-sanitize, transcript.jsonl_parser⟩,
  bar-metrics    ↦ ⟨L2≺bar-store, T/R/L/Δ/E_ledger⟩,
  bar-review     ↦ ⟨L2≺bar-store,bar-index, detector+recommend_engine⟩,
  bar-root-resolve↦ ⟨L0, shared_root-resolution(DB-root+workspace-root,provenance-visible,∅deps_by_design,INV-10)⟩,
  bar-mcp        ↦ ⟨L3≺bar-store,bar-sanitize,bar-index,bar-registry,bar-root-resolve, MCP_stdio_server(read-only)⟩,
  bar-observatory↦ ⟨≺bar-store,bar-ingest,bar-read,bar-root-resolve, bar_CLI(init,ingest,report,doctor,interpret,query)⟩
 }
 |𝒦map|≡16; Published≜{bar,bar-mcp,bar-hook,bar-otlp,bar-proxy}(direct_binaries;remainder=library_𝒦_also_on_crates.io)
}

;; ─── Σ: DATA TYPES ───
⟦Σ:Types⟧{
 ReportDoc≜⟨
  schema_version:𝕊="bar-observatory-report-1.0",
  report:⟨id,title,generated_at,template_version,deterministic:𝔹⟩,
  scope:⟨type,session_count:ℕ,started_at,ended_at⟩,
  summary:⟨runs:ℕ,𝒯_count:ℕ,tool_calls:ℕ,tools:List⟨⟨tool,calls⟩⟩,tasks_total:ℕ,tasks_completed:ℕ,error_results:ℕ,agent_runs:ℕ,agents:List⟨⟨type,count⟩⟩,skills:List⟨⟨𝒮,count⟩⟩,elapsed_ms:ℕ,tokens_total,cost_cents⟩,
  tasks:⟨status:{observed|not_observed},items:List⟨⟨id,title,state,evidence_refs⟩⟩⟩,
  rework:⟨status,events:List⟨⟨id,detail,evidence_refs⟩⟩,hotspots:List⟨⟨path,edits:ℕ⟩⟩⟩,
  human_ai_recovery:⟨status=not_observed⟩,
  validation:⟨status,items:List⟨⟨runs,passed,failed,last_ok:𝔹⟩⟩⟩,
  flaky:⟨status,items:List⟨⟨test,passes,fails⟩⟩⟩,
  failures:⟨status,items:List⟨⟨tool,kind:{mcp|tool|unknown},count⟩⟩⟩,
  observations:⟨status=not_observed⟩,
  capture:⟨channels:List⟨𝒞⟩,health_note⟩,
  integrity:⟨source_db_hash,template_hash,renderer_version,deterministic_render:𝔹,llm_in_render_path:𝔹⟩
 ⟩

 𝒞≜⟨id:{hooks|events|spans|transcripts|requests|provider_cost_usd},status:{not_recorded|partial|complete},recorded:ℕ,reason⟩
 𝒞.provider_cost_usd.src≜requests.{input,output,cache}_tokens(¬own_table,derived_at_render)

 Schema𝒟≜{schema_meta,runs,blobs,spans,requests,events,transcript_turns,micro_results,metrics,task_grades,convergence,method_scores,run_config,raw_logs,hooks,config_snapshot_meta,method_versions,promotions,detector_scores,file_versions,plan_docs,dead_letters,timeline_seq,hook_action_signature,span_prompt_context,sanitize_stats,report_snapshots,trigger_log,config_snapshot,correlation_stats,sqlite_sequence}; |Schema𝒟|≡31 (30_data_tables+sqlite_sequence(SQLite-internal_autoindex_tracker,∅user_data)); +1_view(unified_timeline,∄own_storage,see⟦Σ:Schema⟧)

 runs≜⟨run_id,run_uuid,started_at,ended_at⟩
 𝒯≜⟨turn_id,run_id,seq:ℕ,msg_uuid,parent_uuid,role:{user|assistant|system},block_type:{text|thinking|tool_use|tool_result|other},tool_name,content_excerpt,content_json⟩

 HumanPrompt≜{t∈𝒯|t.role≡user∧t.block_type≡text∧t.tool_name≡∅∧t.content∉Ψ_synthetic}
 Ψ_synthetic≜{"<task-notification>","[Your previous response had no visible output","This session is being continued from a previous conversation"}

 ExampleArtifact≜⟨ReportDoc⟩×⟨BossMode:⟨Ev:boss-mode.ℛ.{html,md},Co:interpreted-executive.html⟩⟩×⟨DeveloperGuide:⟨Ev:real-session.ℛ.{html,md},Co:interpreted-engineering.html⟩⟩
 ExampleArtifact.loc≜bar-observatory/examples/{deterministic,interpreted}/
 ExampleArtifact.src≜⟨𝒲:7_sessions,𝒯:9132,HumanPrompt:68,errors:60,tasks:40/40,rework_hotspots:96⟩; ∀claim∈this_doc:trace(Ε.E6)
}

;; ─── Σ: FULL COLUMN SCHEMA (∀field:real,verified_via_PRAGMA_table_info; 30𝒟_tables+1_view; sqlite_sequence excluded here=autoindex,∅user_field) ───
⟦Σ:Schema⟧{
 Group.identity≜{
  runs≜⟨run_id,run_uuid,trial_id,task_id,condition,session_id,repetition_k,harness,pins_json,status,started_at,ended_at,workspace_path⟩
  schema_meta≜⟨version,applied_at,migration_hash⟩
  config_snapshot≜⟨snapshot_id,run_id,kind,value_json,content_hash,observed_at⟩
  config_snapshot_meta≜⟨run_id,config_snapshot_hash⟩
  run_config≜⟨run_id,config_json,config_hash,config_version⟩
  sanitize_stats≜⟨run_id,source,ruleset_version,secret_key_count,email_count,abs_path_count,residual_count,updated_at⟩
 }; |Group.identity|≡6

 Group.capture≜{
  transcript_turns≜𝒯+⟨transcript_sha,sidechain⟩ (𝒯_defined∈⟦Σ:Types⟧)
  hooks≜⟨hook_id,run_id,session_id,hook_name,tool_name,payload_json,transcript_path,observed_at⟩
  hook_action_signature≜⟨hook_id,action_signature⟩
  spans≜⟨span_id,trace_id,otel_span_id,parent_otel_span_id,run_id,session_id,span_type,name,status,started_at,ended_at,duration_ms,attributes_json⟩
  requests≜⟨request_pk,request_id,run_id,span_id,model,query_source,agent_id,parent_agent_id,context,input_tokens,output_tokens,cache_read_tokens,cache_creation_tokens,thinking_tokens,r_mode,ttft_ms,duration_ms,request_body_sha,response_body_sha⟩
  events≜⟨event_id,run_id,session_id,kind,name,prompt_uuid,value,body_json,observed_at⟩
  raw_logs≜⟨log_id,run_id,channel,seq,line,observed_at⟩
  span_prompt_context≜⟨span_id,prompt_uuid,derivation_method,confidence⟩
  blobs≜⟨blob_sha,path,bytes,mime⟩ (content-addressed;referenced_by_hash_from_other_tables,∅FK_enforced)
  dead_letters≜⟨dl_id,channel,payload_blob_sha,error,observed_at,resolved⟩ (capture_that_failed_to_parse,∅silently_dropped)
  correlation_stats≜⟨run_id,channel,landed_count,skipped_count,updated_at⟩ (schema_v19,DD-08;absence-not-zero_per-run/channel_landed+skipped_tally,∄row⇒that_channel's_ingest_never_ran_this_run)
 }; |Group.capture|≡11

 Group.ledger≜{
  metrics≜⟨run_id,t_input,t_output,t_cache_read,t_cache_create,r_thinking,l_ttft_ms_p50,l_wall_ms,delta,delta_confidence,repair_turns,e_attempts,tool_calls,subagent_count,cost_usd_estimate,computed_at,ledger_version⟩ (≡T/R/L/Δ/E_five-channel_ledger,per⟦Ω:Meta⟧EXP)
  task_grades≜⟨run_id,recovered,score,repair_turns,rubric_hash,grader_version,grader_rationale,condition_blind⟩
  plan_docs≜⟨pd_id,run_id,slug,blob_hash,mtime,correlation⟩
  file_versions≜⟨fv_id,run_id,rel_path,version,blob_hash,backup_time,source⟩
  report_snapshots≜⟨run_id,section,payload_json,schema_version,generated_at,source,model,prompt_hash,verified⟩
  trigger_log≜⟨tl_id,run_id,session_id,trigger_name,event,decision,reason,action,artifact_path,fired_at,duration_ms,detail_json⟩
  timeline_seq≜⟨seq,source_table,source_id,session_id,observed_at⟩ (cross-table_ordering_index)
  unified_timeline≜VIEW⟨seq,ts,session_id,prompt_uuid,log_type,source_table,agent_id,summary⟩ (∪{hooks,events,spans,transcript_turns}∘order_by_ts; ∄own_storage,∅ingest/hook_writes_here_directly)
 }; |Group.ledger.tables|≡7 (+1_view)

 Group.review≜{
  micro_results≜⟨mr_id,run_id,source_turn_id,source_kind,claim_text,claim_hash,extractor_version,extractor_rationale,propagated,evidence_kind,evidence_turn_id,grader_version,grader_rationale,confidence⟩
  convergence≜⟨id,run_id,test,item,arm,variant,delivery,spec_sha256,ambig,divergence,k,n,judge,created_at⟩
  method_versions≜⟨mv_id,kind,version,description,created_at⟩
  method_scores≜⟨ms_id,mv_id,labelset_id,recall,agreement,kappa,calibration_drift,n_items,scored_at⟩
  detector_scores≜⟨ds_id,mv_id,labelset_id,precision,recall,true_positives,false_positives,n_items,scored_at⟩
  promotions≜⟨promo_id,kind,candidate_mv,incumbent_mv,labelset_id,replay_hash,verdict,rationale,promoted_at⟩
 }; |Group.review|≡6

 |Group.identity∪Group.capture∪Group.ledger.tables∪Group.review|≡30 ≡ |Schema𝒟|−{sqlite_sequence}(⟦Σ:Types⟧)
}

;; ─── Γ: OPERATING RULES ───
⟦Γ:Rules⟧{
 G1≜∀𝒟,∀t∈{json,html,md}:ℛ(𝒟,t)@τ₁≡ℛ(𝒟,t)@τ₂(∅LLM∧∅net∈render_path)
 G2≜absent(𝒞)⇒render(not_recorded)≢render(0)
 G3≜ℛ∩Commentary≡∅(ℐb_pins_∀number;prose_from_it_⊬invent)
 G4≜write∈{CLI}∧read∈{CLI,MCP}(MCP⊬mutate,per_bar-mcp_ADR-049)
 G5≜𝒬.--sql_opened_READ_ONLY(engine-enforced,¬regex-filtered)
 G6≜{*.sqlite,bodies/}∉git(only_rendered_ℛ_committed)
 G7≜{bar-hook,bar-mcp}resolved_via_PATH(∅bundled_binary_yet)
 G8≜ingest(tx.jsonl)⇏{hooks,events,spans,requests,provider_cost_usd}(∵these_4𝒞_need_live_capture_during_𝒲,∄post-hoc_recovery)
 G9≜ℛ.∄(--view_flag)(boss-mode.ℛ.*∧Commentary_grouping=hand-built_from_ReportDoc+𝒬,candidate≜ℛ_--view_summary)
 G10≜ingest⊬extract(tx.jsonl.usage_field)(per-turn_token_counts∃∈raw_tx¬∈requests_table;only_bar-proxy_live_capture_populates_correctly)
 G11≜{publish(crates.io),push(REPO)}⇒human_approval(∀swarm:⊬cross_without_explicit_go-ahead∀instance)
 G12≜⟦Ε⟧∈this_doc(self-certifying,per_upstream/aisp/AI_GUIDE.md:443)
 G13≜{hooks,otlp,proxy}.on⇏[measurements.*].enabled(2_distinct_toggle_surfaces,⊬conflate); [measurements.<cat>].enabled=false⇒report-layer_gate_only(¬raw-capture_gate) ∵consumed_only∈bar-observatory/src/lib.rs(verified:∅hits∈bar-hook∨bar-otlp∨bar-proxy_source); see⟦Λ:Toggles⟧
}

;; ─── Γ: AGENT PROTOCOL (this repo's instance of upstream ⟦Γ:Agent⟧) ───
⟦Γ:Agent⟧{
 ∀agent:task≡fetch(bar_data)⇒use{𝒬,MCP}∧⊬guess
 ∀agent:task≡cite(bar_metric)⇒cite(Ε.E6∨live_𝒬)∧⊬unsourced
 ∀response(γ):Ambig(response)<0.02∧δ(response)≥0.40
 prose_only∧task(spec∨coordinate)⇒prefer(AISP)(this_doc=worked_example)
 drift_detected⇒reparse(this_doc)∧trust(Σ)≻trust(memory)
}

;; ─── Γ: AI↔AI BINDING (Δ⊗λ applied to this system's own pipeline, proof-carrying not decorative) ───
⟦Γ:Binding⟧{
 ;; upstream case-order: Logic∩=⊥→0(crash) | Sock∩=∅→1(null) | Type≠→2(adapt) | Post⊆Pre→3(zero-cost)
 Δ⊗λ(init,ingest)≜2 ∵ Pre(ingest)⊇{𝒟,tx.jsonl}∧Post(init)={𝒟}∧tx.jsonl∉Post(init)
 Δ⊗λ(ingest,ℛ)≜3 ∵ Post(ingest)={rows(𝒯)}⊆Pre(ℛ)
 Δ⊗λ(ingest,interpret)≜3 ∵ Post(ingest)⊆Pre(interpret)
 Δ⊗λ(ℛ,doctor)≜3 ∵ Post(ℛ)⊇{valid(𝒟)}⊇Pre(doctor)
 Δ⊗λ(*,𝒬)≜3 ∵ Pre(𝒬)={𝒟}⊆Post(∀prior_step)
 Δ⊗λ(*,MCP)≜3 ∵ MCP.Pre≡𝒬.Pre
 ∀A,B:|{Δ⊗λ(A,B)}|≡1(case-exhaustive∧disjoint,per_upstream∴line316)
}

;; ─── Λ: OPERATIONS (literal CLI verbs, unsymbolized by design — these ARE the interface) ───
⟦Λ:Ops⟧{
 init≜bar_init[--dir<d>]:∅→𝒟∈<d>/.bar/{config.toml,ambient.sqlite,index.sqlite,bodies/}; idempotent≜⊤; ∅arg⇒d≔cwd
 ingest≜bar_ingest<𝒟><tx.jsonl>[--run-uuid<u>]:Pre{𝒟,tx.jsonl}→Post{rows(𝒯),row(runs)}; stdout≜N_𝒯
 ingest.u.default≜"bar-ingest"(collides_if_∅_twice⇒always_pass_u); ingest.repeatable≜⊤(∀s∈𝒲:ingest(s,distinct_u))
 ℛ≜bar_report<𝒟>[--out<d>]:Pre{rows(𝒯)}→Post{files(<d>/<stem>.ℛ.{json,html,md}),byte_identical}
 ℛ.audience≜∅(1_shape="DeveloperGuide.Evidence"); ℛ.cost≜$0.00; ℛ.llm_in_path≜⊥
 doctor≜bar_doctor[<𝒟>]:stdout(checks)∧exit≜0⇔(𝒟≡∅∨valid(𝒟))
 interpret≜bar_interpret<𝒟>--audience{executive|engineering}[--out<d>]:Pre{rows(𝒯)}→Post{file(ℐb)}
 interpret.facts≜⟨𝒯,tool_calls,tasks_total,tasks_done,𝒜_dispatches,errors,tokens,cost⟩; |facts|≡7
 interpret.inv≜prose⊆facts(⊬invent∧⊬round); interpret≠ℛ(hotspots∧top-N_prompts require ReportDoc_directly)
 𝒬≜bar_query<𝒟>{named|--sql"SELECT…"|--list}[--format{table|json|csv}][--limit<N>](N.default≜50;0≜∀)
 𝒬.named≜⟨tools:⟨tool,calls⟩,timeline:⟨seq,role,block,tool⟩,errors:⟨seq,tool,excerpt⟩⟩
 𝒬.sql_grammar≜∀stmt:stmt.head∈{SELECT,WITH}
 mcp≜bar-mcp; mcp.connect≜claude_mcp_add_bar-observatory_--_bar-mcp_--db-root<dir>
 mcp.tools≜{list_runs,get_ledger,get_run_report,query_delta_findings,get_convergence,compare_conditions,get_dead_letters,get_completeness,search_observations,list_findings,recall_context,get_hub}; |mcp.tools|≡12
 mcp.get_hub≜λ().this_doc; mcp.read_only≜⊤(G4)
 slash≜{/bar-init,/bar-report,/bar-interpret,/bar-doctor,/bar-query}; slash↦CLI(1:1,∖ingest)
}

;; ─── Λ: RECIPES (composable per ⟦Γ:Binding⟧) ───
⟦Λ:Recipes⟧{
 R1≜init(--dir<d>)
 R2≜ingest(𝒟,tx,--run-uuid<label>)
 R3≜∀tx∈𝒲:R2(tx,distinct_label) ⇒ 1_𝒟∧summary.runs≡|𝒲|
 R4≜ℛ(𝒟,--out<d>)
 R5≜doctor(𝒟)
 R6≜interpret(𝒟,executive,--out<d>)∘hand(ℐb)→LLM→BossMode.Commentary
 R7≜interpret(𝒟,engineering,--out<d>)∘hand(ℐb)→LLM→DeveloperGuide.Commentary
 R8≜𝒬(𝒟,errors,--limit_0,--format_csv)
 R9≜𝒬(𝒟,tools)
 R10≜𝒬(𝒟,timeline,--limit_0)
 R11≜𝒬(𝒟,--sql"SELECT…FROM transcript_turns WHERE…")
 R12≜𝒬(𝒟,--list)
 R13≜mcp.connect(dir)∘list_runs→get_run_report(run_id)→{list_findings,search_observations}
 R14≜R1∘R2∘R4∘R5; Δ⊗λ(R1,R2)=2⇒supply(tx)externally, Δ⊗λ(R2,R4)=Δ⊗λ(R4,R5)=3⇒zero-cost
 R15≜𝒬(𝒟,--sql"SELECT r.run_uuid,COUNT(*) FROM transcript_turns t JOIN runs r ON t.run_id=r.run_id WHERE t.content_json LIKE'%is_error%true%'GROUP BY r.run_uuid"); R15≈¬≡ReportDoc.summary.error_results(Χ.C1)
}

;; ─── Λ: ASK-MAP (question ↦ correct source; per⟦Γ:Agent⟧ "use{𝒬,MCP}∧⊬guess" — resolve here before inventing a query) ───
⟦Λ:AskMap⟧{
 Q.tool_usage              ↦ 𝒬(𝒟,tools) ∨ mcp.get_ledger
 Q.timeline_of_session     ↦ 𝒬(𝒟,timeline,--limit_0) ∨ 𝒬(𝒟,--sql"…FROM unified_timeline…") ∨ mcp.get_run_report
 Q.errors_in_session       ↦ 𝒬(𝒟,errors) first; R15(raw_LIKE_scan)≢authoritative(Χ.C1)⇒cite(ReportDoc.summary.error_results)_not_R15
 Q.cost_or_tokens          ↦ requests.{input,output,cache}_tokens (𝒞.provider_cost_usd.src; G8: only_populated_if_bar-proxy_was_live_this_run)
 Q.files_churned           ↦ ReportDoc.rework.hotspots (rendered,ranked) ∨ file_versions(rel_path,version) (raw)
 Q.agent/subagent_activity ↦ ReportDoc.summary.agents (rendered) ∨ hooks(hook_name∈{SubagentStart,SubagentStop}) ∨ spans(span_type≡agent) (raw)
 Q.skill_invocations       ↦ ReportDoc.summary.skills (rendered) ∨ hooks.payload_json (raw,per-event)
 Q.rework/redo_events      ↦ ReportDoc.rework.events (G3: ℐb_pins_these; ⊬re-derive_from_raw_tables_yourself,detector_logic_lives_in_bar-review)
 Q.task_ledger             ↦ ReportDoc.tasks ∨ mcp.get_run_report(run_id) ∨ task_grades (raw)
 Q.cross-run_comparison    ↦ mcp.compare_conditions(∅db_arg⇒∀runs) ∨ mcp.list_runs
 Q.past_context/findings   ↦ mcp.recall_context ∨ mcp.search_observations ∨ mcp.list_findings (always_cross-run_index,per⟦Ω:Meta⟧cross-run_note)
 Q.capture_health          ↦ bar_doctor(𝒟) ∨ ReportDoc.capture.channels(𝒞.status) ∨ mcp.get_completeness
 Q.raw_transcript_text     ↦ transcript_turns.content_excerpt (bounded,cheap) ∨ .content_json (full,large)
 Q.validation/test_runs    ↦ ReportDoc.validation.items ∨ task_grades (raw)
 Q.review/recommendations  ↦ mcp.query_delta_findings ∨ mcp.get_dead_letters ∨ detector_scores (raw)
 Q.convergence_experiments ↦ mcp.get_convergence ∨ convergence (raw)
 ∀Q∉this_map ⇒ 𝒬(𝒟,--sql"SELECT…FROM<Group.*_table∈⟦Σ:Schema⟧>") (G5:read-only_enforced,∅harm_in_trying) ∨ mcp.get_hub (re-route,fetches_this_doc)
}

;; ─── Λ: CAPTURE TOGGLES (verified against source, not the config file's own comments — 3 distinct on/off surfaces, G13) ───
⟦Λ:Toggles⟧{
 hooks.on   ≜ plugin_install(bar181/bar-observatory) ⇒ wires_21_events(hooks/hooks.json) → `bar-hook <EventName>` (PATH-resolved,G7)
 hooks.off  ≜ /plugin_uninstall_bar-observatory@bar-observatory ∨ remove_event_entries∈.claude/settings.json (if_hand-wired,∅plugin)
 hooks.events ≜ {SessionStart,SessionEnd,UserPromptSubmit,PreToolUse,PostToolUse,PostToolUseFailure,PermissionRequest,PermissionDenied,SubagentStart,SubagentStop,PreCompact,PostCompact,Notification,Stop,StopFailure,UserPromptExpansion,PostToolBatch,TaskCreated,TaskCompleted,InstructionsLoaded,ConfigChange}; |hooks.events|≡21

 otlp.on  ≜ run(bar-otlp) ∧ point_ClaudeCode's_OTEL_exporter_at_it
 otlp.env ≜ ⟨OBSERVATORY_OTLP_BIND=127.0.0.1:4317(gRPC,default), OBSERVATORY_OTLP_HTTP_BIND=127.0.0.1:4318(HTTP,default), OBSERVATORY_DB, OBSERVATORY_BLOB_ROOT=./bodies(default)⟩
 otlp.off ≜ ¬run(bar-otlp) ∨ ClaudeCode_OTEL_exporter_unset

 proxy.on   ≜ run(bar-proxy) ∧ ANTHROPIC_BASE_URL≔proxy_bind
 proxy.env  ≜ ⟨OBSERVATORY_PROXY_BIND=127.0.0.1:8787(default), OBSERVATORY_UPSTREAM_URL=https://api.anthropic.com(default), OBSERVATORY_RUN_UUID, OBSERVATORY_DB, OBSERVATORY_BLOB_ROOT⟩
 proxy.off  ≜ ¬run(bar-proxy) ∨ ANTHROPIC_BASE_URL_unset
 proxy.auth ≜ forwards_whatever_ClaudeCode_sends_verbatim(∅reads_ANTHROPIC_API_KEY,ADR-024)

 ingest.on ≜ N/A (one-shot_CLI_invocation_per_R2,∅daemon,∅persistent_state_to_toggle) — either_you_run_bar_ingest_or_you_don't, each_call_independent

 report.measurement_gate ≜ [measurements.<category>].enabled=false ∈ .bar/config.toml(project,wins) ∨ bar-observatory.default.toml(base)
 report.measurement_gate.scope ≜ suppresses_that_category_from_ReportDoc_ONLY(G13); raw_rows_in{hooks,spans,requests,events}_still_written_if_the_capture_channel_above_is_live — gate≠stop-capture
 report.measurement_gate.categories ≜ {session,prompts,tasks,agents,skills,tools,terminal,files,git,provider_usage,validation,process,rework,human_ai_recovery,micro_observations}
}

;; ─── Χ: ERRORS (real taxonomy, examples/deterministic/, Ψ_synthetic∉this_set) ───
⟦Χ:Errors⟧{
 C1: R15≢ReportDoc.summary.error_results ⇒ cite(ReportDoc)_not_R15(authoritative)
 C2: Bash(rm_-rf∨cred_grep) ⇒ denied("guardrail,¬defect";28%|errors|_this_𝒲)
 C3: Agent(type∉installed) ⇒ "Agent type '…' not found" ∴ check_availability≺dispatch
 C4: Skill(name∉installed) ⇒ "Unknown skill: …" ∴ ≡C3_fix
 C5: Edit(file∉recently_read) ⇒ "File has not been read yet" ∴ re-read≺edit(long_𝒲)
 C6: Edit(old_string.matches>1) ⇒ "N matches,replace_all=false" ∴ widen(old_string)∨replace_all≜⊤
 C7: Read(input≢JSON) ⇒ InputValidationError ∴ ad-hoc_script_fragility(¬a_bar_bug)
 C8: Bash(multi-cmd_chain) ⇒ excerpt_may_cite_a_LATER_success_line(¬the_failing_one) ∴ pull_full_seq_via_𝒬,⊬trust_excerpt_alone
}

